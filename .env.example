# Only needed when the website (Netlify) and the realtime server (Render etc.) are on DIFFERENT URLs.
# Set this in Netlify > Site configuration > Environment variables, then redeploy.
# Leave unset if one Node server serves everything.
VITE_SERVER_URL=https://your-cinetogether-server.onrender.com

# Server-side email verification via Resend. Create an API key and verify the
# sender domain/address in Resend, then set these on your server deployment.

# Backend only (optional): restrict which sites may call the API. Default is any origin.
# ALLOWED_ORIGIN=https://your-site.netlify.app
